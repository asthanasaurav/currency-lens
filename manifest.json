{
  "manifest_version": 3,
  "name": "Currency Lens",
  "version": "1.5.1",
  "description": "Hover over prices or focus amount fields to see the detected currency converted to currencies you choose.",
  "permissions": ["activeTab", "alarms", "storage"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Currency Lens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/currencies.js", "shared/dom.js", "shared/theme.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
